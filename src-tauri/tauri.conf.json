{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ParaTwin",
  "version": "1.3.1",
  "identifier": "com.paragoncorp.paratwin",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm --prefix ../web run build",
    "frontendDist": "../web/out"
  },
  "app": {
    "windows": [
      {
        "title": "ParaTwin \u2014 ParaExpress Digital Twin (ParagonCorp)",
        "width": 1440,
        "height": 920,
        "minWidth": 1180,
        "minHeight": 720,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Business",
    "shortDescription": "ParaExpress digital twin simulator",
    "longDescription": "ParagonCorp ParaTwin: discrete-event, agent-based and Monte Carlo digital twin for the ParaExpress hyperlocal fulfillment network.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}